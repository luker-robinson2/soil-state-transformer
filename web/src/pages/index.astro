---
import Base from '../layouts/Base.astro';
import MultiTruthPanel from '../components/charts/MultiTruthPanel.tsx';
import { HEADLINE } from '../data/results';

const stats = [
  { v: '256-d', l: 'learned latent z' },
  { v: '9', l: 'fused modalities' },
  { v: '3', l: 'independent ground truths' },
  { v: '6', l: 'self-supervised objectives' },
];
---

<Base>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <!-- soft topographic backdrop -->
    <div
      class="pointer-events-none absolute inset-0 -z-10 opacity-[0.5]"
      aria-hidden="true"
    >
      <svg width="100%" height="100%" preserveAspectRatio="xMidYMid slice">
        <defs>
          <radialGradient id="glow" cx="72%" cy="18%" r="60%">
            <stop offset="0%" stop-color="#d8e6d3" stop-opacity="0.55" />
            <stop offset="100%" stop-color="#d8e6d3" stop-opacity="0" />
          </radialGradient>
        </defs>
        <rect width="100%" height="100%" fill="url(#glow)" />
      </svg>
    </div>

    <div class="mx-auto max-w-6xl px-5 pb-10 pt-20 sm:px-8 sm:pt-28">
      <p class="eyebrow reveal">Multi-modal geospatial representation learning</p>
      <h1
        class="reveal mt-5 max-w-4xl text-4xl font-semibold leading-[1.06] tracking-tight text-ink sm:text-6xl"
      >
        A <span class="text-moss-600">verifiable</span> latent of soil
        <span class="block">and place.</span>
      </h1>
      <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-ink-2">
        GeoSoil compresses the geospatial state of a location — foundation
        embeddings, optical and radar spectra, terrain, and climate time series —
        into a single 256-dimensional vector, trained with self-supervised
        cross-modal objectives and evaluated against
        <span class="font-medium text-ink">multiple independent ground truths.</span>
      </p>

      <div class="reveal mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/geosoil"
          class="group inline-flex items-center gap-2 rounded-full bg-moss-700 px-5 py-2.5 text-paper transition-colors hover:bg-moss-800"
        >
          Read the case study
          <span class="transition-transform duration-300 group-hover:translate-x-0.5"
            >→</span
          >
        </a>
        <a
          href="#finding"
          class="inline-flex items-center gap-2 rounded-full border border-line-strong px-5 py-2.5 text-ink-2 transition-colors hover:border-moss-400 hover:text-moss-600"
        >
          See the multi-truth finding
        </a>
      </div>

      <!-- stat strip -->
      <div
        class="reveal mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-4"
      >
        {
          stats.map((s) => (
            <div class="bg-card px-5 py-6">
              <p class="tnum text-2xl font-semibold text-moss-700">{s.v}</p>
              <p class="mt-1 text-sm text-ink-3">{s.l}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- THE FINDING -->
  <section id="finding" class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14">
      <div class="reveal">
        <p class="eyebrow">The headline</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
          A model can ace a benchmark and still know nothing.
        </h2>
        <p class="mt-5 text-[1.02rem] leading-relaxed text-ink-2">
          Popular gridded soil products are themselves machine-learning outputs of
          satellite covariates. Validate a satellite model against them and you risk
          <span class="font-medium text-ink">circularity</span> — high accuracy that
          reflects shared inputs, not soil.
        </p>
        <p class="mt-4 text-[1.02rem] leading-relaxed text-ink-2">
          The remedy is independent, lab-measured truth. Switch the ground truth on the
          right and watch texture R² fall below zero — then recover, partially and
          honestly, once radar and bare-soil modalities are added.
        </p>
        <p
          class="mt-6 inline-flex items-center gap-2 rounded-lg bg-moss-50 px-3.5 py-2 text-sm text-moss-800"
        >
          <span class="font-mono text-xs">↓</span>
          The contribution is the representation + the protocol, not a leaderboard number.
        </p>
      </div>
      <div class="reveal">
        <MultiTruthPanel client:visible />
      </div>
    </div>
  </section>

  <!-- WHAT IT IS -->
  <section class="border-y border-line bg-paper-2/40">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
      <div class="grid gap-12 md:grid-cols-3">
        <div class="reveal">
          <div
            class="mb-4 grid h-10 w-10 place-items-center rounded-xl bg-moss-100 text-moss-700"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="3" width="7" height="7" rx="1.5" fill="currentColor" opacity="0.9" />
              <rect x="14" y="3" width="7" height="7" rx="1.5" fill="currentColor" opacity="0.5" />
              <rect x="3" y="14" width="7" height="7" rx="1.5" fill="currentColor" opacity="0.5" />
              <rect x="14" y="14" width="7" height="7" rx="1.5" fill="currentColor" opacity="0.9" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-ink">A representation, not a regressor</h3>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-2">
            The self-supervised objectives don’t depend on soil labels, so the same
            frozen latent transfers to any point-referenced geospatial task by swapping
            the head — yield, biomass, hydrology, land value.
          </p>
        </div>
        <div class="reveal">
          <div
            class="mb-4 grid h-10 w-10 place-items-center rounded-xl bg-moss-100 text-moss-700"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="2" />
              <circle cx="12" cy="12" r="4" fill="currentColor" opacity="0.4" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-ink">Honest uncertainty</h3>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-2">
            A heteroscedastic head predicts μ and σ per property; deep ensembles capture
            epistemic spread; split-conformal intervals give coverage guarantees you can
            check on the calibration plot.
          </p>
        </div>
        <div class="reveal">
          <div
            class="mb-4 grid h-10 w-10 place-items-center rounded-xl bg-moss-100 text-moss-700"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M4 18c4-1 6-9 8-9s4 8 8 7" stroke="currentColor" stroke-width="2" fill="none" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-ink">Verifiable by construction</h3>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-2">
            Spatial-block cross-validation everywhere, three independent ground truths,
            and every figure regenerated from the repository. Nothing on this site is a
            number without a source.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
    <div
      class="reveal relative overflow-hidden rounded-3xl border border-moss-200 bg-moss-700 px-8 py-14 text-paper sm:px-14"
    >
      <div class="relative z-10 max-w-2xl">
        <p class="font-mono text-xs uppercase tracking-[0.14em] text-moss-100/80">
          Flagship case study
        </p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">
          The full method, the bake-off, and the limits.
        </h2>
        <p class="mt-4 text-[1.02rem] leading-relaxed text-moss-50/90">
          Architecture, the six objectives, a baseline bake-off against
          LightGBM / XGBoost / CatBoost, calibration, the multi-truth analysis,
          and an honest account of what satellites simply cannot see.
        </p>
        <a
          href="/geosoil"
          class="mt-7 inline-flex items-center gap-2 rounded-full bg-paper px-5 py-2.5 text-moss-800 transition-transform hover:translate-x-0.5"
        >
          Open the case study →
        </a>
      </div>
      <div class="pointer-events-none absolute -right-10 -top-10 h-72 w-72 opacity-20" aria-hidden="true">
        <svg viewBox="0 0 200 200" fill="none">
          {Array.from({ length: 6 }).map((_, i) => (
            <circle cx="100" cy="100" r={20 + i * 14} stroke="#d8e6d3" stroke-width="1.2" />
          ))}
        </svg>
      </div>
    </div>
  </section>
</Base>
